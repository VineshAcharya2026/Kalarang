{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Saree product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "collectionId": { "type": "string" },
        "fabric": { "type": "string" },
        "work": { "type": "string" },
        "border": { "type": "string" },
        "texture": { "type": "string" },
        "occasions": { "type": "array" },
        "colors": { "type": "array" },
        "mrp": { "type": "number" },
        "salePrice": { "type": "number" },
        "images": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "inStock": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "slug", "collectionId", "fabric", "mrp", "salePrice", "inStock"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Product collection category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "coverImage": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "slug", "isActive"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "pincode": { "type": "string" },
        "notes": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "phone", "address", "pincode", "items", "total", "status", "createdAt"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Hero banner slides/promotional cards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "imageUrl": { "type": "string" },
        "headline": { "type": "string" },
        "subtext": { "type": "string" },
        "ctaLabel": { "type": "string" },
        "ctaLink": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "imageUrl", "isActive"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global store settings configuration",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "announcementBar": { "type": "object" },
        "freeShippingThreshold": { "type": "number" }
      },
      "required": ["storeName", "whatsappNumber", "announcementBar", "freeShippingThreshold"]
    },
    "HeroVideo": {
      "title": "HeroVideo",
      "description": "Uploaded or linked promotional videos for hero background or video section",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "videoUrl": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "videoUrl", "title", "isActive"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Saree product items"
    },
    "/collections/{collectionId}": {
      "schema": "Collection",
      "description": "Fabric-wise catalog collections"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchased customer order inquiries"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Promotional banners displayed on the landing page"
    },
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "Global shop metadata config"
    },
    "/videos/{videoId}": {
      "schema": "HeroVideo",
      "description": "Hero background promotional showcase videos"
    }
  }
}
