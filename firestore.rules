rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Defend-By-Default Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Architectural Primitives & Helpers ---
    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Explicit Admin designation leveraging the verified user email address from runtime context
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == "vineshjm@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    // --- Collections ---

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collections Collection
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners Collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Videos Collection
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Anyone can create an order, but must follow strict parameters
      allow create: if true 
        && incoming().keys().hasAll(['customerName', 'phone', 'address', 'pincode', 'items', 'total', 'status', 'createdAt'])
        && incoming().customerName is string && incoming().customerName.size() <= 200
        && incoming().phone is string && incoming().phone.size() <= 20
        && incoming().address is string && incoming().address.size() <= 1000
        && incoming().pincode is string && incoming().pincode.size() <= 15
        && incoming().status == 'pending'
        && incoming().createdAt == request.time;
        
      // Only administrators can read or update (for status changes)
      allow read, update: if isAdmin();
      allow delete: if false; // Orders should never be hard deleted
    }
  }
}
